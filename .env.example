# These variables must be exported by your shell; .env is not automatically read.
INNO_HOST=127.0.0.1
INNO_PORT=4173
# Optional stable token, at least 24 random characters. Never commit the real value.
# INNO_ACCESS_TOKEN=
INNO_DB_PATH=.inno/tasks.sqlite
INNO_EXECUTOR_WORKSPACE=.inno/executor-workspace
# Public frontend origins explicitly allowed by this server, comma separated.
# INNO_CORS_ORIGINS=https://your-frontend.example
# Official subscription Routine only. Not model API keys.
# CLAUDE_ROUTINE_URL=https://api.anthropic.com/v1/claude_code/routines/YOUR_ROUTINE/fire
# CLAUDE_ROUTINE_TOKEN=
